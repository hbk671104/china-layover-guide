---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/*
  Self-hosted variable fonts, preloaded.

  The font CSS uses `font-display: swap`, so without a preload the first paint
  is the system fallback and the real face swaps in a moment later. Both files
  are same-origin and immutable, so preloading costs one early request and
  removes the visible jump.
*/
import frauncesOpsz from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import geistWght from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  image?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = '/',
  type = 'website',
  image = '/og-default.png',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const siteName = 'China Layover Guide';
const siteUrl = 'https://chinalayoverguide.com';

const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        name: siteName,
        url: `${siteUrl}/`,
        logo: `${siteUrl}/favicon.svg`,
      },
      {
        '@type': 'WebSite',
        name: siteName,
        url: `${siteUrl}/`,
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: `${siteUrl}/search/?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      },
    ],
  },
];

const allJsonLd = [...siteJsonLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesOpsz} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={geistWght} crossorigin="anonymous" />
    {/*
      Client-side navigation. Without it every in-site click is a full document
      load: the tab shows the URL until the next <title> parses, the fonts are
      re-evaluated into a fallback-then-swap flash, and scroll is lost.

      Scripts in components run once per document, so anything that binds to the
      DOM must re-bind on the `astro:page-load` event (see Header).
    */}
    <ClientRouter />
    <Seo
      {title}
      {description}
      {canonicalPath}
      {type}
      {image}
      siteName={siteName}
      jsonLd={allJsonLd}
      {noindex}
    />
  </head>
  {/*
    `id="top"` lives on <body>, not on the sticky <header>. A sticky element is
    always "in view" at the viewport edge, so the browser refuses to scroll to
    it and the footer's Back-to-top link only moves by scroll-padding.
  */}
  <body id="top" class="flex min-h-screen flex-col bg-paper text-body antialiased">
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
