---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  image?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = '/',
  type = 'website',
  image = '/og-default.png',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const siteName = 'China Layover Guide';
const siteUrl = 'https://chinalayoverguide.com';

const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        name: siteName,
        url: `${siteUrl}/`,
        logo: `${siteUrl}/favicon.svg`,
      },
      {
        '@type': 'WebSite',
        name: siteName,
        url: `${siteUrl}/`,
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: `${siteUrl}/search/?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      },
    ],
  },
];

const allJsonLd = [...siteJsonLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      {title}
      {description}
      {canonicalPath}
      {type}
      {image}
      siteName={siteName}
      jsonLd={allJsonLd}
      {noindex}
    />
  </head>
  {/*
    `id="top"` lives on <body>, not on the sticky <header>. A sticky element is
    always "in view" at the viewport edge, so the browser refuses to scroll to
    it and the footer's Back-to-top link only moves by scroll-padding.
  */}
  <body id="top" class="flex min-h-screen flex-col bg-paper text-body antialiased">
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
