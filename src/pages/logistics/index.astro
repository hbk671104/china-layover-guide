---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubHeader from '../../components/HubHeader.astro';
import GuideList from '../../components/GuideList.astro';

const siteUrl = 'https://chinalayoverguide.com';

const guides = (
  await getCollection('guides', ({ data }) => data.category === 'logistics')
).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'China Layover Logistics | China Layover Guide',
    description:
      'The practical side of a China layover: airport-to-city transfers, luggage storage, hotel registration, and what to do when things go wrong.',
    url: `${siteUrl}/logistics/`,
    hasPart: guides.map((guide) => ({
      '@type': 'Article',
      headline: guide.data.title,
      url: `${siteUrl}/guides/${guide.id}/`,
    })),
  },
];
---

<BaseLayout
  title="China Layover Logistics: Transfers, Luggage & Registration"
  description="The practical side of a China layover: airport-to-city transfers, luggage storage, hotel registration, and what to do when things go wrong."
  canonicalPath="/logistics/"
  jsonLd={jsonLd}
>
  <HubHeader
    eyebrow={`Layover logistics · ${guides.length} guides`}
    title="Layover logistics"
    lead="The unglamorous parts that decide whether a layover works: getting in from the airport, dropping your bags, registering your stay, and staying out of trouble."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6" aria-labelledby="logistics-guides">
    <h2
      id="logistics-guides"
      class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl"
    >
      Transfers, storage, and rules
    </h2>
    <p class="mt-3 max-w-[44rem] text-muted">
      Start with the return-to-airport buffer, then work backwards through bags, transport, and
      registration.
    </p>
    <div class="mt-8 max-w-[52rem]">
      <GuideList guides={guides} showCategory={false} />
    </div>
  </section>
</BaseLayout>
