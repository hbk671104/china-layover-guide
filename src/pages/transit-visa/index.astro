---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubHeader from '../../components/HubHeader.astro';
import GuideList from '../../components/GuideList.astro';
import EligibilityChecker from '../../components/EligibilityChecker';

const guides = (
  await getCollection('guides', ({ data }) => data.category === 'transit-visa')
).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const siteUrl = 'https://chinalayoverguide.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'China Transit Visa & 240-Hour Visa-Free Rules | China Layover Guide',
    description:
      "How China's 240-hour visa-free transit policy works, who qualifies, and how to use it on your layover.",
    url: `${siteUrl}/transit-visa/`,
    hasPart: guides.map((guide) => ({
      '@type': 'Article',
      headline: guide.data.title,
      url: `${siteUrl}/guides/${guide.id}/`,
    })),
  },
];
---

<BaseLayout
  title="China Transit Visa & 240-Hour Visa-Free Rules"
  description="How China's 240-hour visa-free transit policy works, who qualifies, and how to use it on your layover."
  jsonLd={jsonLd}
  canonicalPath="/transit-visa/"
>
  <HubHeader
    eyebrow="240-hour visa-free transit for 55 countries at 65 ports"
    title="Do you need a transit visa for China?"
    lead="Most layover travelers don't. If your passport is from one of 55 eligible countries and your onward flight goes to a third country, you can stay for up to 240 hours and leave the airport."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6" aria-labelledby="eligibility">
    <h2 id="eligibility" class="eyebrow text-muted">Start here</h2>
    <p class="mt-3 max-w-[44rem] text-lg leading-relaxed text-body">
      Answer the four questions below, then read the rules that decide the borderline cases.
    </p>
    <div class="mt-8 max-w-[52rem]">
      <EligibilityChecker client:load />
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="transit-guides">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h2
        id="transit-guides"
        class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl"
      >
        Transit rules, in depth
      </h2>
      <div class="mt-8 max-w-[52rem]">
        <GuideList guides={guides} showCategory={false} />
      </div>
    </div>
  </section>
</BaseLayout>
