---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubHeader from '../../components/HubHeader.astro';
import GuideList from '../../components/GuideList.astro';
import PaymentRecommender from '../../components/PaymentRecommender';

const guides = (
  await getCollection('guides', ({ data }) => data.category === 'payments')
).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const siteUrl = 'https://chinalayoverguide.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Payments in China for Foreign Travelers | China Layover Guide',
    description:
      'Visa and Mastercard acceptance is limited in China. How to pay with Alipay, WeChat Pay, and TenPayGo using the cards you already have.',
    url: `${siteUrl}/payments/`,
    hasPart: guides.map((guide) => ({
      '@type': 'Article',
      headline: guide.data.title,
      url: `${siteUrl}/guides/${guide.id}/`,
    })),
  },
];
---

<BaseLayout
  title="Payments in China for Foreign Travelers"
  description="Visa and Mastercard acceptance is limited in China. Here's how to pay with Alipay, WeChat Pay, and TenPayGo using the cards you already have."
  canonicalPath="/payments/"
  jsonLd={jsonLd}
>
  <HubHeader
    eyebrow="Payments · set this up before you fly"
    title="Payments that actually work"
    lead="China runs on QR codes. Hotels and big stores take a Visa or Mastercard; small shops, restaurants, and taxis mostly don't. Linking your card to Alipay or WeChat Pay covers almost everything, and a little cash is still worth carrying as backup."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6" aria-labelledby="recommender">
    <h2 id="recommender" class="eyebrow text-muted">Your setup</h2>
    <p class="mt-3 max-w-[44rem] text-lg leading-relaxed text-body">
      Pick your card and phone to see the shortest path to a working payment method.
    </p>
    <div class="mt-8 max-w-[52rem]">
      <PaymentRecommender client:load />
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="payment-guides">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h2
        id="payment-guides"
        class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl"
      >
        Cards, apps, and cash
      </h2>
      <div class="mt-8 max-w-[52rem]">
        <GuideList guides={guides} showCategory={false} />
      </div>
    </div>
  </section>
</BaseLayout>
