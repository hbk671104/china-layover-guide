---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideList from '../../components/GuideList.astro';
import PaymentRecommender from '../../components/PaymentRecommender';

const guides = (
  await getCollection('guides', ({ data }) => data.category === 'payments')
).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const siteUrl = 'https://chinalayoverguide.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Payments in China for Foreign Travelers | China Layover Guide',
    description:
      'Visa and Mastercard acceptance is limited in China. How to pay with Alipay, WeChat Pay, and TenPayGo using the cards you already have.',
    url: `${siteUrl}/payments/`,
    hasPart: guides.map((guide) => ({
      '@type': 'Article',
      headline: guide.data.title,
      url: `${siteUrl}/guides/${guide.id}/`,
    })),
  },
];
---

<BaseLayout
  title="Payments in China for Foreign Travelers"
  description="Visa and Mastercard acceptance is limited in China. Here's how to pay with Alipay, WeChat Pay, and TenPayGo using the cards you already have."
  canonicalPath="/payments/"
  jsonLd={jsonLd}
>
  <header class="mx-auto max-w-3xl px-4 pt-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
      Payments that actually work
    </h1>
    <p class="mt-4 text-lg text-slate-600">
      China runs on QR codes. Hotels and big stores take a Visa or Mastercard; small shops,
      restaurants, and taxis mostly don&rsquo;t. Linking your card to Alipay or WeChat Pay covers
      almost everything, and a little cash is still worth carrying as backup. Pick your card and
      phone below to see the setup for your case.
    </p>
  </header>

  <section class="mx-auto max-w-3xl px-4 py-8">
    <PaymentRecommender client:load />
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10">
    <h2 class="text-2xl font-bold text-slate-900">Guides</h2>
    <div class="mt-6">
      <GuideList {guides} />
    </div>
  </section>
</BaseLayout>
