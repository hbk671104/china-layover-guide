---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — China Layover Guide"
  description="The page you are looking for does not exist."
  canonicalPath="/404"
>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-6xl font-extrabold tracking-tight text-slate-900">404</h1>
    <p class="mt-4 text-lg text-slate-600">
      The page you are looking for doesn&rsquo;t exist or has moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-[var(--color-brand)] px-6 py-3 font-semibold text-white hover:bg-[var(--color-brand-dark)]"
    >
      Back to the guide
    </a>
  </section>
</BaseLayout>
