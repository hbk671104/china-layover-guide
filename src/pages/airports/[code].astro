---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { airports } from '../../data/airports';

export async function getStaticPaths() {
  return airports.map((airport) => ({
    params: { code: airport.code },
    props: { airport },
  }));
}

const { airport } = Astro.props;
const code = airport.code.toUpperCase();
const siteUrl = 'https://chinalayoverguide.com';
const canonicalPath = `/airports/${airport.code}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    mainEntityOfPage: `${siteUrl}${canonicalPath}`,
    headline: `${airport.name} (${code}) layover guide`,
    description: `How to use a layover at ${code}: transfer times to ${airport.city}, what fits in each window, luggage storage, and visa-free transit eligibility.`,
    image: `${siteUrl}/og-default.png`,
    dateModified: new Date(airport.updated).toISOString(),
    author: {
      '@type': 'Organization',
      name: 'China Layover Guide',
      url: `${siteUrl}/about/`,
    },
    publisher: {
      '@type': 'Organization',
      name: 'China Layover Guide',
      url: `${siteUrl}/about/`,
      logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Airports', item: `${siteUrl}/airports/` },
      { '@type': 'ListItem', position: 3, name: code, item: `${siteUrl}${canonicalPath}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `Can I leave ${code} airport on a layover?`,
        answer: airport.transitEligible
          ? `Yes, if you qualify for China's visa-free entry or 240-hour visa-free transit. ${code} is a designated transit port, so eligible travelers can enter and travel within ${airport.permittedArea}.`
          : `${code} is not a designated port for the 240-hour visa-free transit policy. Check whether the 30-day visa-free entry or a visa applies to you.`,
      },
      {
        '@type': 'Question',
        name: `How long does it take to get from ${code} to ${airport.city}?`,
        answer: `${airport.transfers[0].mode} takes about ${airport.transfers[0].time}. Expect to pay around ${airport.transfers[0].cost}.`,
      },
      {
        '@type': 'Question',
        name: `What is the minimum layover to leave ${code}?`,
        answer: `Roughly ${airport.minViableHours} hours at the airport before leaving is worthwhile, and ${airport.comfortableHours}+ hours is comfortable. Below ${airport.minViableHours} hours, stay airside.`,
      },
      {
        '@type': 'Question',
        name: `Is there luggage storage at ${code}?`,
        answer: airport.luggage.available
          ? `Yes. ${airport.luggage.location} Expect around ${airport.luggage.cost}.`
          : `Confirm current luggage storage options with the airport before you travel.`,
      },
    ],
  },
];

const related = airports.filter((other) => other.code !== airport.code).slice(0, 4);

const atAGlance = [
  { value: `${airport.minViableHours}h`, label: 'Minimum layover worth leaving for' },
  { value: `${airport.comfortableHours}h`, label: 'Comfortable minimum' },
  { value: airport.distance, label: `Distance into ${airport.city}` },
  {
    value: airport.luggage.available ? 'Yes' : 'Unconfirmed',
    label: 'Luggage storage at the airport',
  },
];
---

<BaseLayout
  title={`${code} Layover Guide | ${airport.name}`}
  description={`How to use a layover at ${code} (${airport.name}): transfer times to ${airport.city}, what fits in 6, 8, 12, and 24 hours, luggage storage, and whether you can leave the airport.`}
  canonicalPath={canonicalPath}
  type="article"
  jsonLd={jsonLd}
>
  <div class="relative isolate overflow-hidden border-b border-line ambient-warm">
    <div aria-hidden="true" class="route-arcs absolute inset-0 opacity-70"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-10 pb-12 sm:px-6 sm:pt-14">
      <nav aria-label="Breadcrumb" class="text-sm">
        <a
          href="/airports/"
          class="font-semibold text-muted transition-colors duration-200 hover:text-brand"
        >
          <span aria-hidden="true">←</span> All airports
        </a>
      </nav>

      <div class="mt-6 flex flex-wrap items-start justify-between gap-6">
        <header class="max-w-[44rem]">
          <p class="eyebrow">
            {airport.city} · leave the airport from ~{airport.minViableHours}h
          </p>
          <h1
            class="mt-4 flex items-baseline gap-4 font-display text-[2.1rem] leading-none font-semibold tracking-[-0.03em] text-ink sm:text-[2.75rem]"
          >
            <span class="tabular-nums">{code}</span>
            <span class="text-faint">Layover guide</span>
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-muted">
            {airport.name} · {airport.distance}
          </p>
        </header>

        <div class="text-xs leading-relaxed text-faint sm:max-w-[16rem] sm:text-right">
          <p>
            Researched and fact-checked by the{' '}
            <a href="/about/" class="link">editorial team</a> against official sources.
          </p>
          <p class="mt-1">
            Last reviewed{' '}
            <time datetime={new Date(airport.updated).toISOString()} class="tabular-nums">
              {new Date(airport.updated).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div
    class="mx-auto grid max-w-6xl gap-x-16 gap-y-12 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,44rem)_1fr] lg:py-16"
  >
    <div class="min-w-0">
      <section>
        <h2 class="eyebrow text-muted">The short answer</h2>
        <p class="mt-4 border-l-2 border-brand pl-5 text-lg leading-relaxed text-body">
          You need roughly <strong class="font-semibold text-ink">{airport.minViableHours} hours</strong
          > at {code} before leaving the airport is worthwhile, and <strong
            class="font-semibold text-ink">{airport.comfortableHours}+ hours</strong
          > to be comfortable. {airport.transfers[0].mode} gets you to {airport.city} in about{' '}
          {airport.transfers[0].time}.
          {
            airport.transitEligible
              ? ` ${code} is a designated port under the 240-hour visa-free transit policy, covering ${airport.permittedArea}.`
              : ''
          }
        </p>
      </section>

      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink">
          Getting into {airport.city}
        </h2>
        <ul class="mt-6 border-t border-line">
          {
            airport.transfers.map((transfer) => (
              <li class="border-b border-line py-5">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                  <h3 class="font-display text-lg font-semibold tracking-[-0.01em] text-ink">
                    {transfer.mode}
                  </h3>
                  {transfer.trafficProof ? (
                    <span class="inline-flex items-center gap-1.5 rounded-sm bg-ok-bg px-2 py-0.5 text-[0.7rem] font-semibold tracking-[0.06em] text-ok uppercase">
                      <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-ok" />
                      Traffic-proof
                    </span>
                  ) : (
                    <span class="rounded-sm bg-surface-2 px-2 py-0.5 text-[0.7rem] font-semibold tracking-[0.06em] text-faint uppercase">
                      Can be delayed
                    </span>
                  )}
                </div>
                <p class="mt-2 text-sm leading-relaxed text-muted">{transfer.notes}</p>
                <dl class="mt-3 flex flex-wrap gap-x-8 gap-y-2">
                  <div class="flex items-baseline gap-2">
                    <dt class="text-[0.7rem] font-semibold tracking-[0.08em] text-faint uppercase">
                      Time
                    </dt>
                    <dd class="text-sm text-body tabular-nums">{transfer.time}</dd>
                  </div>
                  <div class="flex items-baseline gap-2">
                    <dt class="text-[0.7rem] font-semibold tracking-[0.08em] text-faint uppercase">
                      Cost
                    </dt>
                    <dd class="text-sm text-body tabular-nums">{transfer.cost}</dd>
                  </div>
                </dl>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink">
          What fits in each window
        </h2>
        <ol class="mt-6 border-t border-line">
          {
            airport.windows.map((window) => (
              <li class="grid gap-2 border-b border-line py-5 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-8">
                <div>
                  <h3 class="font-display text-lg font-semibold tracking-[-0.01em] text-ink">
                    {window.label}
                  </h3>
                  <p class="mt-1 text-xs font-semibold tracking-[0.06em] text-brand uppercase">
                    {window.verdict}
                  </p>
                </div>
                <p class="text-sm leading-relaxed text-muted">{window.detail}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink">
          Luggage storage
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{airport.luggage.location}</p>
        <p class="mt-2 text-sm text-muted">
          <span class="font-semibold text-ink">Cost:</span>
          <span class="tabular-nums"> {airport.luggage.cost}</span>
        </p>
      </section>

      <section class="mt-14 rounded-card border border-warn/25 bg-warn-bg p-6">
        <h2 class="font-display text-xl font-semibold tracking-[-0.01em] text-warn">
          {code} traps to avoid
        </h2>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-warn">
          {
            airport.gotchas.map((gotcha) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-warn" />
                {gotcha}
              </li>
            ))
          }
        </ul>
      </section>

      <p class="mt-12 border-t border-line pt-6 text-xs leading-relaxed text-faint">
        Transfer times, fares, and operating hours change. Verify against the airport&rsquo;s own
        transport page and the National Immigration Administration before you book.
      </p>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <h2 class="eyebrow text-muted">At a glance</h2>
      <dl class="mt-4 divide-y divide-line border-y border-line">
        {
          atAGlance.map((item) => (
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="text-sm leading-snug text-muted">{item.label}</dt>
              <dd
                class:list={[
                  'text-right text-ink',
                  item.value.length <= 6
                    ? 'font-display text-lg font-semibold tabular-nums'
                    : 'text-sm',
                ]}
              >
                {item.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-8 rounded-card border border-line bg-surface-2 p-5">
        <h2 class="font-display text-base font-semibold text-ink">Entry rules</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          {
            airport.transitEligible
              ? `Covered by the 240-hour visa-free transit policy. Permitted area: ${airport.permittedArea}.`
              : 'Check the current visa-free rules for this port before you book.'
          }
        </p>
        <a href="/transit-visa/" class="btn btn-primary mt-4 w-full px-4 py-2.5 text-sm">
          Check eligibility
        </a>
      </div>

      <nav aria-labelledby="related-guides" class="mt-8">
        <h2 id="related-guides" class="eyebrow text-muted">Related guides</h2>
        <ul class="mt-3 space-y-2.5 text-sm">
          {
            airport.citySlug && (
              <li>
                <a
                  href={`/cities/${airport.citySlug}/`}
                  class="text-body transition-colors duration-200 hover:text-brand"
                >
                  {airport.city} layover guide
                </a>
              </li>
            )
          }
          <li>
            <a
              href="/guides/china-airport-to-city-transfers/"
              class="text-body transition-colors duration-200 hover:text-brand"
            >
              Every major hub compared
            </a>
          </li>
          <li>
            <a
              href="/guides/luggage-storage-at-china-airports/"
              class="text-body transition-colors duration-200 hover:text-brand"
            >
              Luggage storage at China&rsquo;s airports
            </a>
          </li>
          <li>
            <a
              href="/guides/can-you-leave-the-airport-during-a-china-layover/"
              class="text-body transition-colors duration-200 hover:text-brand"
            >
              Can you leave the airport?
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="other-airports" class="mt-8">
        <h2 id="other-airports" class="eyebrow text-muted">Other airports</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            related.map((other) => (
              <li>
                <a
                  href={`/airports/${other.code}/`}
                  class="flex items-baseline justify-between gap-3 text-muted transition-colors duration-200 hover:text-brand"
                >
                  <span class="font-mono text-xs font-semibold text-faint">
                    {other.code.toUpperCase()}
                  </span>
                  <span class="flex-1 truncate">{other.city}</span>
                  <span class="text-faint">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>
</BaseLayout>
