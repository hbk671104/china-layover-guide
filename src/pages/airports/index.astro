---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubHeader from '../../components/HubHeader.astro';
import { airports } from '../../data/airports';

const siteUrl = 'https://chinalayoverguide.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Airport layover guides | China Layover Guide',
    description:
      'Layover guides for every major Chinese airport: transfer times, what fits in each window, luggage storage, and whether you can leave the airport.',
    url: `${siteUrl}/airports/`,
    hasPart: airports.map((airport) => ({
      '@type': 'Article',
      headline: `${airport.name} (${airport.code.toUpperCase()}) layover guide`,
      url: `${siteUrl}/airports/${airport.code}/`,
    })),
  },
];
---

<BaseLayout
  title="China Airport Layover Guides: PVG, PEK, CAN & More"
  description="Layover guides for China's major airports: transfer times, the smallest window worth leaving for, luggage storage, and whether you can leave the airport."
  canonicalPath="/airports/"
  jsonLd={jsonLd}
>
  <HubHeader
    eyebrow={`${airports.length} airports · transfer times and minimum windows`}
    title="Airport layover guides"
    lead="From Shanghai Pudong to Xi'an Xianyang. Each guide covers the transfer into the city, what actually fits in your window, luggage storage, and the mistakes that cost travelers their onward flight."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6" aria-labelledby="airport-index">
    <h2 id="airport-index" class="eyebrow text-muted">Browse by airport</h2>

    <ul class="mt-6 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-3">
      {
        airports.map((airport) => (
          <li>
            <a
              href={`/airports/${airport.code}/`}
              class="group flex h-full min-h-[10.5rem] flex-col justify-between border-r border-b border-line bg-paper p-6 transition-colors duration-200 hover:bg-surface"
            >
              <div>
                <div class="flex items-baseline justify-between gap-3">
                  <span class="font-mono text-sm font-semibold tracking-[0.08em] text-brand tabular-nums">
                    {airport.code.toUpperCase()}
                  </span>
                  {
                    airport.transitEligible && (
                      <span class="rounded-sm bg-brand-tint px-2 py-0.5 text-[0.65rem] font-semibold tracking-[0.08em] text-brand-ink uppercase">
                        Transit port
                      </span>
                    )
                  }
                </div>
                <h3 class="mt-3 font-display text-2xl font-semibold tracking-[-0.02em] text-ink transition-colors duration-200 group-hover:text-brand">
                  {airport.city}
                </h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{airport.name}</p>
              </div>
              <p class="mt-4 flex flex-wrap items-baseline gap-x-3 border-t border-line pt-3 text-xs text-faint tabular-nums">
                <span>
                  <span class="font-semibold text-muted">Leave from</span>
                  {' ~'}
                  {airport.minViableHours}h
                </span>
                <span aria-hidden="true">·</span>
                <span>{airport.distance}</span>
              </p>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 grid gap-6 rounded-panel border border-line bg-surface-2 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <h2 class="font-display text-xl font-semibold tracking-[-0.01em] text-ink">
          Before you plan around any of these
        </h2>
        <p class="mt-2 max-w-[42rem] text-sm leading-relaxed text-muted">
          Leaving the airport depends on your nationality and your onward ticket, not just your
          layover length. Check the rules first: the airport only decides how long the transfer
          takes.
        </p>
      </div>
      <div class="flex flex-col gap-2.5 lg:min-w-[15rem]">
        <a href="/transit-visa/" class="btn btn-primary">Check eligibility</a>
        <a href="/guides/240-hour-visa-free-transit/" class="btn btn-secondary text-sm">
          Read the 240-hour rules
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
