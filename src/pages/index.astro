---
import BaseLayout from '../layouts/BaseLayout.astro';

const pillars = [
  {
    href: '/transit-visa/',
    title: 'Visa-free transit',
    description:
      'Do you even need a visa? Check 55 countries, 65 ports, and the third-country rule that decides most cases.',
  },
  {
    href: '/esim/',
    title: 'eSIM & connectivity',
    description:
      "Google Maps, WhatsApp, and Gmail stop working when you land. Install an eSIM before you fly and they keep working.",
  },
  {
    href: '/payments/',
    title: 'Payments',
    description:
      "Hotels and big stores take a Visa card; small shops and taxis don't. Link your card to Alipay or WeChat Pay first.",
  },
  {
    href: '/cities/',
    title: 'City trips',
    description:
      'Hour-by-hour plans for 12 Chinese cities, from a five-hour stop at Hongqiao to a full day in Beijing.',
  },
  {
    href: '/logistics/',
    title: 'Layover logistics',
    description:
      'Airport transfers, luggage storage, hotel registration, and the return buffer that decides whether you make your flight.',
  },
];

const steps = [
  {
    title: 'Before you fly',
    body: 'Install an eSIM, add your card to Alipay or WeChat Pay, and save your onward ticket offline — the airline will ask for it at check-in.',
  },
  {
    title: 'At immigration',
    body: 'Use the 240-hour visa-free transit lane with your passport, arrival card, and onward ticket to a third country. The clock starts at 00:00 the day after you enter.',
  },
  {
    title: 'On the ground',
    body: 'Take the airport express or a DiDi, pay by QR code, and be back at the airport 2.5–3 hours before an international departure.',
  },
];
---

<BaseLayout
  title="China Layover Guide: Visa-Free Transit, eSIM & City Plans"
  description="Leave the airport on your China layover. Check 240-hour visa-free transit eligibility, set up an eSIM, and get hour-by-hour plans for 12 cities."
>
  <section class="bg-gradient-to-b from-red-50 to-white">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
      <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-brand)]">
        240-hour visa-free transit &middot; 55 countries &middot; 65 ports
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Turn your China layover into a <span class="text-[var(--color-brand)]">real trip</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-600">
        Passports from 55 countries &mdash; including the UK, US, Canada, Australia, New Zealand, and
        every EU state &mdash; can exit the airport without a visa under the 240-hour transit policy.
        Here&rsquo;s what it takes to walk out of the terminal and make it back for your flight.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/transit-visa/"
          class="rounded-lg bg-[var(--color-brand)] px-6 py-3 font-semibold text-white hover:bg-[var(--color-brand-dark)]"
        >
          Check my visa-free eligibility
        </a>
        <a
          href="/cities/"
          class="rounded-lg border border-slate-300 px-6 py-3 font-semibold text-slate-700 hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]"
        >
          Browse city layover plans
        </a>
      </div>
      <ul class="mt-8 grid max-w-3xl gap-2 text-sm text-slate-600 sm:grid-cols-3">
        <li>55 countries, 65 ports, 240 hours &mdash; from official sources</li>
        <li>Payment and eSIM guides tested on foreign cards</li>
        <li>A last-updated date and sources on every page</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-bold text-slate-900">The five things a layover depends on</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        pillars.map((pillar) => (
          <li>
            <a
              href={pillar.href}
              class="block h-full rounded-xl border border-slate-200 p-6 transition hover:border-[var(--color-brand)]"
            >
              <h3 class="text-xl font-bold text-slate-900">{pillar.title}</h3>
              <p class="mt-2 text-slate-600">{pillar.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6">
      <a href="/guides/" class="font-semibold text-[var(--color-brand)] hover:underline">
        Browse all guides &rarr;
      </a>
    </p>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-2xl font-bold text-slate-900">How a smooth layover goes</h2>
      <ol class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <span class="text-sm font-bold text-[var(--color-brand)]">Step {index + 1}</span>
              <h3 class="mt-1 font-bold text-slate-900">{step.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
