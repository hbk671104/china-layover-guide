---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pillars = [
  {
    href: '/transit-visa/',
    title: 'Visa-free transit',
    description:
      'Do you even need a visa? Check 55 countries, 65 ports, and the third-country rule that decides most cases.',
  },
  {
    href: '/esim/',
    title: 'eSIM and connectivity',
    description:
      'Google Maps, WhatsApp, and Gmail stop working when you land. Install an eSIM before you fly and they keep working.',
  },
  {
    href: '/payments/',
    title: 'Payments',
    description:
      "Hotels and big stores take a Visa card; small shops and taxis don't. Link your card to Alipay or WeChat Pay first.",
  },
  {
    href: '/cities/',
    title: 'City trips',
    description:
      'Hour-by-hour plans for 12 Chinese cities, from a five-hour stop at Hongqiao to a full day in Beijing.',
  },
  {
    href: '/logistics/',
    title: 'Layover logistics',
    description:
      'Airport transfers, luggage storage, hotel registration, and the return buffer that decides whether you make your flight.',
  },
];

const facts = [
  { value: '55', unit: 'countries', label: 'Passports eligible for visa-free transit' },
  { value: '65', unit: 'ports', label: 'Designated air, land, rail, and sea entry points' },
  { value: '240', unit: 'hours', label: 'Maximum stay, counting from 00:00 the day after entry' },
  { value: '3', unit: 'months', label: 'Minimum passport validity beyond entry' },
];

const steps = [
  {
    when: 'Before you fly',
    title: 'Install and test',
    body: 'Install an eSIM, add your card to Alipay or WeChat Pay, and save your onward ticket offline: the airline will ask for it at check-in.',
  },
  {
    when: 'At immigration',
    title: 'Use the transit lane',
    body: 'Show your passport, arrival card, and onward ticket to a third country. The clock starts at 00:00 the day after you enter.',
  },
  {
    when: 'On the ground',
    title: 'Move, pay, return',
    body: 'Take the airport express or a DiDi, pay by QR code, and be back at the airport 2.5–3 hours before an international departure.',
  },
];

const allGuides = await getCollection('guides');
const guideCount = allGuides.length;

const starters = (
  await getCollection('guides', ({ data }) =>
    ['transit-visa', 'esim', 'payments', 'logistics'].includes(data.category),
  )
)
  .sort((a, b) => a.data.category.localeCompare(b.data.category) || b.data.updated.valueOf() - a.data.updated.valueOf())
  .filter(
    (guide, index, all) => all.findIndex((other) => other.data.category === guide.data.category) === index,
  )
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const categoryLabels: Record<string, string> = {
  'transit-visa': 'Transit visa',
  esim: 'eSIM',
  payments: 'Payments',
  logistics: 'Logistics',
  cities: 'City trips',
};
---

<BaseLayout
  title="China Layover Guide: Visa-Free Transit, eSIM & City Plans"
  description="Leave the airport on your China layover. Check 240-hour visa-free transit eligibility, set up an eSIM, and get hour-by-hour plans for 12 cities."
>
  <section class="relative isolate overflow-hidden border-b border-line ambient-warm">
    <div aria-hidden="true" class="dot-grid absolute inset-0 opacity-50"></div>
    <div
      aria-hidden="true"
      class="route-arcs absolute inset-0 opacity-40 [mask-image:linear-gradient(to_bottom,black,transparent_72%)]"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-24">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <p class="eyebrow" data-reveal>240-hour visa-free transit for 55 countries at 65 ports</p>

          <h1
            class="mt-6 font-display text-[2.6rem] leading-[0.96] font-semibold tracking-[-0.035em] text-ink sm:text-6xl lg:text-[4rem]"
            data-reveal
            style="--reveal-delay:60ms"
          >
            Turn your China layover into a{' '}
            <span class="relative whitespace-nowrap text-brand">
              real trip
              <svg
                aria-hidden="true"
                viewBox="0 0 200 12"
                preserveAspectRatio="none"
                class="absolute -bottom-1 left-0 h-2.5 w-full text-brand/40"
                fill="none"
              >
                <path
                  d="M2 8.5C34 4 96 2.5 198 6.5"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"></path>
              </svg>
            </span>
          </h1>

          <p
            class="mt-8 max-w-[34rem] text-lg leading-relaxed text-muted"
            data-reveal
            style="--reveal-delay:120ms"
          >
            Travelers from 55 countries can leave the airport visa-free for up to 240 hours and
            still make the flight.
          </p>

          <div
            class="mt-10 flex flex-wrap items-center gap-3"
            data-reveal
            style="--reveal-delay:180ms"
          >
            <a href="/transit-visa/" class="btn btn-primary">
              Check my visa-free eligibility
              <span aria-hidden="true">→</span>
            </a>
            <a href="/cities/" class="btn btn-secondary">Browse city layover plans</a>
            <a href="/guides/" class="btn btn-quiet">All {guideCount} guides</a>
          </div>
        </div>

        <div class="lg:col-span-5 lg:mt-6" data-reveal style="--reveal-delay:240ms">
          <dl class="panel divide-y divide-line overflow-hidden">
            {
              facts.map((fact) => (
                <div class="flex flex-col gap-1 px-6 py-5 sm:flex-row sm:items-baseline sm:gap-5">
                  <dt class="flex items-baseline gap-1 font-display text-3xl font-semibold tracking-[-0.03em] text-brand tabular-nums sm:w-24 sm:shrink-0">
                    {fact.value}
                    <span class="font-sans text-xs font-semibold tracking-wide text-faint uppercase">
                      {fact.unit}
                    </span>
                  </dt>
                  <dd class="text-sm leading-snug text-muted">{fact.label}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-3 px-1 text-xs leading-relaxed text-faint">
            Figures from the National Immigration Administration&rsquo;s current visa-free transit
            policy. Rules change. Every page carries its own sources and review date.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
        The five things a layover depends on
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Get these in order and a stopover becomes a day out. Miss one and you spend it airside.
      </p>
    </div>

    <ol class="mt-12 border-b border-line">
      {
        pillars.map((pillar, index) => (
          <li>
            <a
              href={pillar.href}
              class="index-row md:grid-cols-[3.5rem_1fr_auto] md:items-start md:gap-6"
            >
              <span class="font-mono text-xs font-semibold text-faint tabular-nums">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>
                <span class="index-title font-display text-2xl font-semibold tracking-[-0.02em] text-ink">
                  {pillar.title}
                </span>
                <span class="mt-1.5 block max-w-[46rem] text-muted">{pillar.description}</span>
              </span>
              <span aria-hidden="true" class="index-arrow hidden text-lg text-brand md:block">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y border-line bg-surface-2">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="max-w-2xl">
        <p class="eyebrow">Sequence</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
          How a smooth layover goes
        </h2>
      </div>

      <ol class="mt-14 grid gap-12 sm:grid-cols-3 sm:gap-8">
        {
          steps.map((step) => (
            <li class="relative border-t border-line-strong pt-7">
              <span
                aria-hidden="true"
                class="absolute -top-[0.6rem] left-0 grid h-5 w-5 place-items-center rounded-full border border-line-strong bg-paper"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-brand" />
              </span>
              <p class="font-mono text-[0.7rem] font-semibold tracking-[0.16em] text-faint uppercase">
                {step.when}
              </p>
              <h3 class="mt-2.5 font-display text-xl font-semibold text-ink">{step.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="eyebrow">Start reading</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
          The four guides to read first
        </h2>
      </div>
      <a href="/guides/" class="link text-sm font-semibold">All {guideCount} guides →</a>
    </div>

    <ul class="mt-12 grid gap-x-10 gap-y-0 border-b border-line md:grid-cols-2">
      {
        starters.map((guide) => (
          <li>
            <a href={`/guides/${guide.id}/`} class="index-row">
              <span class="flex items-baseline gap-3 text-xs">
                <span class="font-semibold tracking-[0.1em] text-brand uppercase">
                  {categoryLabels[guide.data.category]}
                </span>
                <span class="text-faint tabular-nums">
                  {guide.data.updated.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </span>
              </span>
              <span class="index-title font-display text-xl font-semibold tracking-[-0.015em] text-ink">
                {guide.data.title}
              </span>
              <span class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted">
                {guide.data.description}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
