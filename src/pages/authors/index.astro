---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { authors } from '../../data/authors';
import { getCollection } from 'astro:content';

const siteUrl = 'https://chinalayoverguide.com';

const guides = await getCollection('guides');
const cities = await getCollection('cities');

const cards = authors.map((author) => {
  const written = [
    ...guides.filter((g) => author.categories.includes(g.data.category)),
    ...cities,
  ].length;
  return { author, count: written };
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Authors — China Layover Guide',
    description:
      'The people who research, test and write the China Layover Guide. Who they are, where they live, and what they can personally vouch for.',
    url: `${siteUrl}/authors/`,
    hasPart: authors.map((author) => ({
      '@type': 'Person',
      name: author.name,
      url: `${siteUrl}/authors/${author.slug}/`,
    })),
  },
];
---

<BaseLayout
  title="Authors | China Layover Guide"
  description="The people who research and write the China Layover Guide. Both live in Beijing; one has used China's visa-free transit as a foreigner, one tests the payment apps and eSIMs on this site."
  canonicalPath="/authors/"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-[52rem] px-4 py-14 sm:px-6">
    <header>
      <h1 class="font-display text-[2.1rem] leading-[1.05] font-semibold tracking-[-0.03em] text-ink sm:text-[2.75rem]">
        Who writes this
      </h1>
      <p class="mt-5 max-w-[38rem] text-lg leading-relaxed text-muted">
        Two people, both living in Beijing. Everything here is written from China, not researched
        from abroad.
      </p>
    </header>

    <section class="mt-10 space-y-4">
      {
        cards.map(({ author, count }) => (
          <a
            href={`/authors/${author.slug}/`}
            class="group flex items-start gap-4 rounded-card bg-surface-2 p-5 transition-colors duration-200 hover:bg-brand-tint"
          >
            {author.avatar ? (
              <img
                src={author.avatar}
                alt={author.name}
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
                class="h-16 w-16 shrink-0 rounded-[16px] object-cover"
              />
            ) : (
              <span
                aria-hidden="true"
                class="flex h-16 w-16 shrink-0 items-center justify-center rounded-[16px] bg-surface text-lg font-semibold text-muted"
              >
                {author.name.split(' ').map((p) => p[0]).join('')}
              </span>
            )}
            <div>
              <h2 class="font-display text-xl font-semibold tracking-[-0.02em] text-ink">
                {author.name}
              </h2>
              <p class="text-sm font-semibold text-brand">{author.role}</p>
              <p class="mt-2 leading-relaxed text-muted">{author.tagline}</p>
              <p class="mt-2 text-sm text-faint tabular-nums">
                {count} guide{count === 1 ? '' : 's'} · {author.location}
              </p>
            </div>
          </a>
        ))
      }
    </section>

    <section class="mt-12 rounded-panel border border-line bg-surface-2 p-6 sm:p-7">
      <h2 class="font-display text-xl font-semibold tracking-[-0.02em] text-ink">
        How we check things
      </h2>
      <p class="mt-2 text-sm text-muted">
        Not everything on a travel site can be tested. Some things can be looked up. We try to be
        clear about which is which.
      </p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>
          <strong class="text-ink">Payment and connectivity guides</strong> are based on
          first-hand testing. Bokang sets up each app and eSIM plan on a foreign card and confirms
          what actually works.
        </li>
        <li>
          <strong class="text-ink">Visa and transit rules</strong> are checked against
          publications from the National Immigration Administration (NIA). No one can self-test a
          visa rule, so we cite the source instead of claiming otherwise.
        </li>
        <li>
          <strong class="text-ink">Airline and airport details</strong> come from the airline
          or airport's own published terms, linked at the foot of each page.
        </li>
      </ul>
      <p class="mt-3 text-sm text-muted">
        Every factual page carries a last-updated date and a source list. If something looks wrong,
        the correction address is listed on the{' '}
        <a href="/about/" class="text-brand hover:underline">
          about page
        </a>
        .
      </p>
    </section>

    <p class="mt-8 text-sm text-faint">
      <a href="/about/" class="text-brand hover:underline">
        More about this site &rarr;
      </a>
    </p>
  </article>
</BaseLayout>
