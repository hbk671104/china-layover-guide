---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubHeader from '../../components/HubHeader.astro';
import GuideList from '../../components/GuideList.astro';

const cities = (await getCollection('cities')).sort((a, b) =>
  a.data.city.localeCompare(b.data.city),
);

const itineraries = (
  await getCollection('guides', ({ data }) => data.category === 'cities')
).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const siteUrl = 'https://chinalayoverguide.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'City Quick Trips | China Layover Guide',
    description:
      "Fast, realistic layover routes for China's major cities: what to see, how to get there, and how long you need.",
    url: `${siteUrl}/cities/`,
    hasPart: [
      ...cities.map((city) => ({
        '@type': 'Article',
        headline: `${city.data.city} layover guide`,
        url: `${siteUrl}/cities/${city.id}/`,
      })),
      ...itineraries.map((guide) => ({
        '@type': 'Article',
        headline: guide.data.title,
        url: `${siteUrl}/guides/${guide.id}/`,
      })),
    ],
  },
];
---

<BaseLayout
  title="China Layover City Trips: What to Do in Your Window"
  description="Twelve Chinese cities where long-haul flights stop: routes, transfer times, and the minimum layover each needs, plus 6, 8, 12, and 24-hour itineraries."
  canonicalPath="/cities/"
  jsonLd={jsonLd}
>
  <HubHeader
    eyebrow={`${cities.length} cities · minimum windows, not wishlists`}
    title="City trips that fit your layover window"
    lead="Twelve cities where long-haul flights stop, each with a route, a transfer plan, and the minimum layover it needs. For Beijing, Shanghai, Guangzhou, Chengdu, and Xi'an there are in-depth plans hour by hour."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6" aria-labelledby="city-index">
    <h2 id="city-index" class="eyebrow text-muted">Browse by city</h2>

    <ul
      class="mt-6 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        cities.map((city) => (
          <li>
            <a
              href={`/cities/${city.id}/`}
              class="group flex h-full min-h-[11rem] flex-col justify-between border-r border-b border-line bg-paper p-6 transition-colors duration-200 hover:bg-surface"
            >
              <div>
                <span class="flex items-baseline justify-between gap-3 text-xs">
                  <span class="font-semibold tracking-[0.1em] text-brand uppercase">
                    {city.data.region}
                  </span>
                  <span
                    aria-hidden="true"
                    class="translate-x-[-4px] text-brand opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
                  >
                    →
                  </span>
                </span>
                <h3 class="mt-3 font-display text-2xl font-semibold tracking-[-0.02em] text-ink transition-colors duration-200 group-hover:text-brand">
                  {city.data.city}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{city.data.bestFor}</p>
              </div>
              <p class="mt-4 border-t border-line pt-3 text-xs text-faint">
                <span class="font-semibold text-muted">Window:</span>{' '}
                {city.data.layoverWindow}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-line" aria-labelledby="itineraries">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h2
        id="itineraries"
        class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl"
      >
        Layover itineraries by window
      </h2>
      <p class="mt-3 max-w-[44rem] text-muted">
        Detailed 6, 8, 12, and 24-hour plans for Beijing, Shanghai, Guangzhou, Chengdu, and
        Xi&rsquo;an — each built around the return-to-airport buffer rather than the most sights.
      </p>
      <div class="mt-8">
        <GuideList guides={itineraries} showCategory={false} columns={2} />
      </div>
    </div>
  </section>
</BaseLayout>
