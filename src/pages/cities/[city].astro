---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroImage from '../../components/HeroImage.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { authorForCategory } from '../../data/authors';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((city) => ({
    params: { city: city.id },
    props: { city },
  }));
}

const { city } = Astro.props;
const { Content } = await render(city);

const allCities = (await getCollection('cities')).sort((a, b) =>
  a.data.city.localeCompare(b.data.city),
);
const otherCities = allCities.filter((other) => other.id !== city.id).slice(0, 5);

const author = authorForCategory('cities');

const siteUrl = 'https://chinalayoverguide.com';
const canonicalPath = `/cities/${city.id}/`;

const brief = [
  { label: 'The route', body: city.data.route },
  { label: 'Getting around', body: city.data.transportTips },
  { label: 'eSIM', body: city.data.eSimTip },
  { label: 'Payments', body: city.data.paymentTip },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    mainEntityOfPage: `${siteUrl}${canonicalPath}`,
    headline: `${city.data.city} layover guide`,
    description: city.data.bestFor,
    image: `${siteUrl}/og-default.png`,
    dateModified: city.data.updated.toISOString(),
    author: {
      '@type': 'Person',
      name: author.name,
      url: `${siteUrl}/authors/${author.slug}/`,
      jobTitle: author.role,
      knowsAbout: author.knowsAbout,
      ...(author.sameAs.length ? { sameAs: author.sameAs } : {}),
    },
    publisher: {
      '@type': 'Organization',
      name: 'China Layover Guide',
      url: `${siteUrl}/about/`,
      logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'City trips',
        item: `${siteUrl}/cities/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: `${city.data.city} layover guide`,
        item: `${siteUrl}${canonicalPath}`,
      },
    ],
  },
];
---

<BaseLayout
  title={`${city.data.city} layover guide | China Layover Guide`}
  description={`How to spend a layover in ${city.data.city}: ${city.data.bestFor}.`}
  type="article"
  canonicalPath={`/cities/${city.id}/`}
  jsonLd={jsonLd}
>
  <div class="relative isolate overflow-hidden border-b border-line ambient-warm">
    <div aria-hidden="true" class="dot-grid absolute inset-0 opacity-50"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-10 pb-12 sm:px-6 sm:pt-14">
      <nav aria-label="Breadcrumb" class="text-sm">
        <a
          href="/cities/"
          class="font-semibold text-muted transition-colors duration-200 hover:text-brand"
        >
          <span aria-hidden="true">←</span> All city trips
        </a>
      </nav>

      <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,44rem)_1fr] lg:gap-16">
        <header>
          <p class="eyebrow">
            {city.data.region} · {city.data.layoverWindow}
          </p>
          <h1
            class="mt-4 font-display text-[2.1rem] leading-[1.05] font-semibold tracking-[-0.03em] text-ink sm:text-[2.75rem]"
          >
            {city.data.city} layover guide
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-muted">{city.data.bestFor}</p>
          <AuthorByline
            author={author}
            updated={city.data.updated.toISOString()}
            note="Verified against the sources linked at the foot of this page."
          />
        </header>

        <aside class="lg:mt-2">
          <h2 class="eyebrow text-muted">Highlights</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              city.data.attractions.map((attraction) => (
                <li class="rounded-sm border border-line bg-surface px-2.5 py-1 text-sm text-body">
                  {attraction}
                </li>
              ))
            }
          </ul>
          <a
            href={city.data.mapLink}
            rel="noopener"
            class="btn btn-secondary mt-5 w-fit text-sm"
          >
            Open {city.data.city} in maps
            <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>
    </div>
  </div>

  {
    city.data.heroImage && (
      <div class="mx-auto mt-10 max-w-6xl px-4 sm:px-6">
        <HeroImage
          src={city.data.heroImage}
          alt={city.data.heroAlt ?? `A view of ${city.data.city}`}
          credit={city.data.heroCredit}
          creditUrl={city.data.heroCreditUrl}
          priority
        />
      </div>
    )
  }

  <div
    class="mx-auto grid max-w-6xl gap-x-16 gap-y-12 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,44rem)_1fr] lg:py-16"
  >
    <div class="min-w-0">
      <div class="prose max-w-none">
        <Content />
      </div>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <h2 class="eyebrow text-muted">The brief</h2>
      <dl class="mt-4 divide-y divide-line border-y border-line">
        {
          brief.map((item) => (
            <div class="py-4">
              <dt class="font-display text-base font-semibold tracking-[-0.01em] text-ink">
                {item.label}
              </dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-muted">{item.body}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-6 text-sm font-semibold text-ink">Leaving the airport?</p>
      <p class="mt-1.5 text-xs leading-relaxed text-muted">
        Transit rules decide whether you can exit — not the length of your stop.
      </p>
      <a href="/transit-visa/" class="btn btn-primary mt-3 w-full px-4 py-2.5 text-sm">
        Check eligibility
      </a>

      <nav aria-labelledby="other-cities" class="mt-8">
        <h2 id="other-cities" class="eyebrow text-muted">Other cities</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            otherCities.map((other) => (
              <li>
                <a
                  href={`/cities/${other.id}/`}
                  class="flex items-baseline justify-between gap-3 text-muted transition-colors duration-200 hover:text-brand"
                >
                  {other.data.city}
                  <span class="text-xs text-faint">{other.data.region}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>
</BaseLayout>
