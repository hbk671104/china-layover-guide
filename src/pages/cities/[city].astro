---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((city) => ({
    params: { city: city.id },
    props: { city },
  }));
}

const { city } = Astro.props;
const { Content } = await render(city);

const jsonLd = [
  {
    '@type': 'Article',
    headline: `${city.data.city} layover guide`,
    description: city.data.bestFor,
    dateModified: new Date().toISOString(),
    author: { '@type': 'Organization', name: 'China Layover Guide' },
  },
];
---

<BaseLayout
  title={`${city.data.city} layover guide — China Layover Guide`}
  description={`How to spend a layover in ${city.data.city}: ${city.data.bestFor}.`}
  type="article"
  canonicalPath={`/cities/${city.id}/`}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <header>
      <a href="/cities/" class="text-sm font-semibold text-[var(--color-brand)] hover:underline">
        &larr; All city trips
      </a>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        {city.data.city} layover guide
      </h1>
      <p class="mt-3 text-lg text-slate-600">
        {city.data.region} · {city.data.bestFor}
      </p>
      <p class="mt-2 text-sm text-slate-500">Suggested window: {city.data.layoverWindow}</p>
    </header>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <section class="rounded-xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900">Route</h2>
        <p class="mt-2 text-sm text-slate-600">{city.data.route}</p>
      </section>
      <section class="rounded-xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900">Highlights</h2>
        <ul class="mt-2 flex flex-wrap gap-2">
          {
            city.data.attractions.map((attraction) => (
              <li class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">
                {attraction}
              </li>
            ))
          }
        </ul>
      </section>
      <section class="rounded-xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900">Getting around</h2>
        <p class="mt-2 text-sm text-slate-600">{city.data.transportTips}</p>
      </section>
      <section class="rounded-xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900">eSIM &amp; payments</h2>
        <p class="mt-2 text-sm text-slate-600"><strong>eSIM:</strong> {city.data.eSimTip}</p>
        <p class="mt-2 text-sm text-slate-600">
          <strong>Payments:</strong> {city.data.paymentTip}
        </p>
      </section>
    </div>

    <div class="prose prose-slate mt-10 max-w-none">
      <Content />
    </div>

    <p class="mt-10">
      <a
        href={city.data.mapLink}
        rel="noopener"
        class="font-semibold text-[var(--color-brand)] hover:underline"
      >
        Open {city.data.city} in maps &rarr;
      </a>
    </p>
  </article>
</BaseLayout>
