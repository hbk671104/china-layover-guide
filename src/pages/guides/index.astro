---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideList from '../../components/GuideList.astro';

const categoryMeta = [
  { key: 'transit-visa', label: 'Visa-free transit & entry rules' },
  { key: 'cities', label: 'City layover itineraries' },
  { key: 'payments', label: 'Payments & apps' },
  { key: 'esim', label: 'eSIM & connectivity' },
  { key: 'logistics', label: 'Airport transfers & logistics' },
] as const;

const guides = await getCollection('guides');

const groups = categoryMeta
  .map((meta) => ({
    label: meta.label,
    guides: guides
      .filter((guide) => guide.data.category === meta.key)
      .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()),
  }))
  .filter((group) => group.guides.length > 0);

const siteUrl = 'https://chinalayoverguide.com';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'All guides — China Layover Guide',
    description:
      'Every China Layover Guide article, grouped by topic: visa-free transit, eSIM, payments, airport transfers, and city layover itineraries.',
    url: `${siteUrl}/guides/`,
    hasPart: guides.map((guide) => ({
      '@type': 'Article',
      headline: guide.data.title,
      url: `${siteUrl}/guides/${guide.id}/`,
    })),
  },
];
---

<BaseLayout
  title="All Guides — China Layover Guide"
  description="Every China Layover Guide article in one place: visa-free transit rules, eSIM setup, payments, airport transfers, and city layover itineraries."
  canonicalPath="/guides/"
  jsonLd={jsonLd}
>
  <header class="mx-auto max-w-5xl px-4 pt-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
      All guides
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600">
      {guides.length} in-depth, independently researched guides for a China layover — grouped by
      topic. Every factual page carries a last-updated date and links to its sources.
    </p>
  </header>

  {
    groups.map((group) => (
      <section class="mx-auto max-w-5xl px-4 py-8">
        <h2 class="text-2xl font-bold text-slate-900">{group.label}</h2>
        <div class="mt-6">
          <GuideList guides={group.guides} />
        </div>
      </section>
    ))
  }
</BaseLayout>
