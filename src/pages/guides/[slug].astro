---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import HeroImage from '../../components/HeroImage.astro';
import FaqSection from '../../components/FaqSection.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { authorForCategory } from '../../data/authors';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const author = authorForCategory(guide.data.category);

const categoryLabel = {
  'transit-visa': 'Transit visa',
  esim: 'eSIM',
  payments: 'Payments',
  cities: 'City trips',
  logistics: 'Layover logistics',
}[guide.data.category];

const siteUrl = 'https://chinalayoverguide.com';
const canonicalPath = `/guides/${guide.id}/`;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    mainEntityOfPage: `${siteUrl}${canonicalPath}`,
    headline: guide.data.title,
    description: guide.data.description,
    image: `${siteUrl}/og-default.png`,
    datePublished: guide.data.updated.toISOString(),
    dateModified: guide.data.updated.toISOString(),
    author: {
      '@type': 'Person',
      name: author.name,
      url: `${siteUrl}/authors/${author.slug}/`,
      jobTitle: author.role,
      knowsAbout: author.knowsAbout,
      ...(author.sameAs.length ? { sameAs: author.sameAs } : {}),
    },
    publisher: {
      '@type': 'Organization',
      name: 'China Layover Guide',
      url: `${siteUrl}/about/`,
      logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: categoryLabel,
        item: `${siteUrl}/${guide.data.category}/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: guide.data.title,
        item: `${siteUrl}${canonicalPath}`,
      },
    ],
  },
];

if (guide.data.faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.data.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  type="article"
  canonicalPath={`/guides/${guide.id}/`}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <header>
      <a
        href={`/${guide.data.category}/`}
        class="text-sm font-semibold text-[var(--color-brand)] hover:underline"
      >
        &larr; {categoryLabel}
      </a>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        {guide.data.title}
      </h1>
      <p class="mt-4 text-lg text-slate-600">{guide.data.description}</p>
      <AuthorByline
        author={author}
        updated={guide.data.updated.toISOString()}
        note={
          author.categories.includes('payments') || author.categories.includes('esim')
            ? 'Tested in China on a foreign card. Sources linked at the foot of this page.'
            : 'Verified against the sources linked at the foot of this page.'
        }
      />
      {
        guide.data.heroImage && (
          <HeroImage
            src={guide.data.heroImage}
            alt={guide.data.heroAlt ?? guide.data.title}
            credit={guide.data.heroCredit}
            creditUrl={guide.data.heroCreditUrl}
            class="mt-6"
            priority
          />
        )
      }
    </header>
    <div class="prose prose-slate mt-10 max-w-none">
      <Content />
    </div>
    <FaqSection faqs={guide.data.faqs} />
    <SourceList sources={guide.data.sources} />
  </article>
</BaseLayout>
