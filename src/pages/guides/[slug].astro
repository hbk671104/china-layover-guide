---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import HeroImage from '../../components/HeroImage.astro';
import FaqSection from '../../components/FaqSection.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { authorForCategory } from '../../data/authors';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

const author = authorForCategory(guide.data.category);

const categoryLabel = {
  'transit-visa': 'Transit visa',
  esim: 'eSIM',
  payments: 'Payments',
  cities: 'City trips',
  logistics: 'Layover logistics',
}[guide.data.category];

const sections = headings.filter((heading) => heading.depth === 2 && heading.text.trim().length > 0);

const siteUrl = 'https://chinalayoverguide.com';
const canonicalPath = `/guides/${guide.id}/`;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    mainEntityOfPage: `${siteUrl}${canonicalPath}`,
    headline: guide.data.title,
    description: guide.data.description,
    image: `${siteUrl}/og-default.png`,
    datePublished: guide.data.updated.toISOString(),
    dateModified: guide.data.updated.toISOString(),
    author: {
      '@type': 'Person',
      name: author.name,
      url: `${siteUrl}/authors/${author.slug}/`,
      jobTitle: author.role,
      knowsAbout: author.knowsAbout,
      ...(author.sameAs.length ? { sameAs: author.sameAs } : {}),
    },
    publisher: {
      '@type': 'Organization',
      name: 'China Layover Guide',
      url: `${siteUrl}/about/`,
      logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: categoryLabel,
        item: `${siteUrl}/${guide.data.category}/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: guide.data.title,
        item: `${siteUrl}${canonicalPath}`,
      },
    ],
  },
];

if (guide.data.faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.data.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  type="article"
  canonicalPath={`/guides/${guide.id}/`}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 pt-10 pb-4 sm:px-6 sm:pt-14">
    <nav aria-label="Breadcrumb" class="text-sm">
      <a
        href={`/${guide.data.category}/`}
        class="font-semibold text-muted transition-colors duration-200 hover:text-brand"
      >
        <span aria-hidden="true">←</span> {categoryLabel}
      </a>
    </nav>

    <header class="mt-6 max-w-[44rem]">
      <h1
        class="font-display text-[2.1rem] leading-[1.05] font-semibold tracking-[-0.03em] text-ink sm:text-[2.75rem]"
      >
        {guide.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">{guide.data.description}</p>
      <AuthorByline
        author={author}
        updated={guide.data.updated.toISOString()}
        note={
          author.categories.includes('payments') || author.categories.includes('esim')
            ? 'Tested in China on a foreign card. Sources linked at the foot of this page.'
            : 'Verified against the sources linked at the foot of this page.'
        }
      />
    </header>
  </div>

  {
    guide.data.heroImage && (
      <div class="mx-auto mt-8 max-w-6xl px-4 sm:px-6">
        <HeroImage
          src={guide.data.heroImage}
          alt={guide.data.heroAlt ?? guide.data.title}
          credit={guide.data.heroCredit}
          creditUrl={guide.data.heroCreditUrl}
          priority
        />
      </div>
    )
  }

  <div
    class="mx-auto grid max-w-6xl gap-x-16 gap-y-12 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,44rem)_1fr] lg:py-16"
  >
    <div class="min-w-0">
      <div class="prose max-w-none">
        <Content />
      </div>

      <FaqSection faqs={guide.data.faqs} />
      <SourceList sources={guide.data.sources} />
    </div>

    {
      sections.length >= 3 && (
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <nav aria-labelledby="on-this-page" class="hidden lg:block">
            <h2 id="on-this-page" class="eyebrow text-muted">
              On this page
            </h2>
            <ol class="mt-4 space-y-2.5 border-l border-line pl-4 text-sm">
              {sections.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="block text-muted transition-colors duration-200 hover:text-brand"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>

          <div class="mt-8 rounded-card border border-line bg-surface-2 p-4">
            <p class="text-sm font-semibold text-ink">Going anyway?</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted">
              Check whether your passport and onward ticket qualify for visa-free transit before you
              book.
            </p>
            <a href="/transit-visa/" class="btn btn-primary mt-3 w-full px-4 py-2.5 text-sm">
              Check eligibility
            </a>
          </div>
        </aside>
      )
    }
  </div>
</BaseLayout>
