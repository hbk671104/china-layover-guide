---
const links = [
  { href: '/transit-visa/', label: 'Transit Visa' },
  { href: '/esim/', label: 'eSIM' },
  { href: '/payments/', label: 'Payments' },
  { href: '/cities/', label: 'City Trips' },
  { href: '/airports/', label: 'Airports' },
  { href: '/logistics/', label: 'Logistics' },
];
---

<header class="border-b border-slate-200">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href="/" class="text-lg font-extrabold tracking-tight text-slate-900">
      China <span class="text-[var(--color-brand)]">Layover</span> Guide
    </a>
    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-4 text-sm font-medium sm:gap-6">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-slate-600 hover:text-[var(--color-brand)]">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
