---
interface Props {
  sources: { label: string; url: string }[];
}

const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="mt-10 rounded-xl bg-slate-50 p-6">
      <h2 class="text-sm font-bold uppercase tracking-wide text-slate-500">
        Sources &amp; official links
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          sources.map((source) => (
            <li>
              <a
                href={source.url}
                rel="noopener"
                class="text-[var(--color-brand)] underline-offset-2 hover:underline"
              >
                {source.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  )
}
