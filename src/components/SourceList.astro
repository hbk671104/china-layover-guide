---
interface Props {
  sources: { label: string; url: string }[];
}

const { sources } = Astro.props;

const host = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};
---

{
  sources.length > 0 && (
    <section class="mt-14 border-t border-line pt-8">
      <h2 class="eyebrow text-muted">Sources &amp; official links</h2>
      <p class="mt-3 max-w-[44rem] text-sm leading-relaxed text-muted">
        Every factual claim on this page traces back to one of these documents. They are the
        authority, not us.
      </p>
      <ol class="mt-6 border-t border-line">
        {sources.map((source, index) => (
          <li>
            <a
              href={source.url}
              rel="noopener"
              class="index-row group md:grid-cols-[2rem_1fr] md:items-baseline md:gap-4"
            >
              <span class="font-mono text-xs font-semibold text-faint tabular-nums">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>
                <span class="index-title text-[0.95rem] font-medium text-ink">{source.label}</span>
                <span class="mt-1 block font-mono text-xs text-faint">{host(source.url)}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}
