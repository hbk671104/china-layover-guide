---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  /** Set on the single most important image above the fold. */
  priority?: boolean;
  /** Attribution text, shown when the licence requires credit. */
  credit?: string;
  /** Link for the attribution (source page or licence deed). */
  creditUrl?: string;
  class?: string;
}

const {
  src,
  alt,
  width = 1400,
  height = 788,
  priority = false,
  credit,
  creditUrl,
  class: className = '',
} = Astro.props;
---

<figure class={`m-0 ${className}`}>
  <div class="overflow-hidden rounded-panel border border-line bg-surface-2">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="h-full w-full object-cover"
    />
  </div>
  {
    credit && (
      <figcaption class="mt-2 flex items-baseline gap-1.5 text-xs text-faint">
        <span class="font-semibold tracking-[0.08em] uppercase">Photo</span>
        {creditUrl ? (
          <a href={creditUrl} rel="noopener nofollow" class="link">
            {credit}
          </a>
        ) : (
          <span>{credit}</span>
        )}
      </figcaption>
    )
  }
</figure>
