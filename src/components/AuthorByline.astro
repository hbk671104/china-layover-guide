---
import type { Author } from '../data/authors';

interface Props {
  author: Author;
  /** ISO date string for the article's last update. */
  updated?: string;
  /** Extra line under the byline, e.g. a verification note. */
  note?: string;
}

const { author, updated, note } = Astro.props;

const initials = author.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<div
  class="mt-7 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-y border-line py-4"
>
  <div class="flex items-center gap-4">
  {
    author.avatar ? (
      <img
        src={author.avatar}
        alt={author.name}
        width="40"
        height="40"
        loading="lazy"
        decoding="async"
        class="h-10 w-10 shrink-0 rounded-[12px] object-cover"
      />
    ) : (
      <span
        aria-hidden="true"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-surface-2 text-sm font-semibold text-muted"
      >
        {initials}
      </span>
    )
  }
  <div class="text-sm text-muted">
    <p class="flex flex-wrap items-baseline gap-x-2">
      <a
        href={`/authors/${author.slug}/`}
        rel="author"
        class="font-semibold text-ink transition-colors duration-200 hover:text-brand"
      >
        {author.name}
      </a>
      <span class="text-faint">· {author.role}</span>
    </p>
    {
      updated && (
        <p class="mt-0.5 text-xs text-faint">
          Last updated{' '}
          <time datetime={updated} class="tabular-nums">
            {new Date(updated).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </p>
      )
    }
  </div>
  </div>
  {note && <p class="max-w-sm text-xs leading-relaxed text-faint sm:text-right">{note}</p>}
</div>
