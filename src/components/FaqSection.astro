---
interface Props {
  faqs: { question: string; answer: string }[];
  title?: string;
}

const { faqs, title = 'Frequently asked questions' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="mt-16 border-t border-line pt-8">
      {/*
        The questions render as visible h3s under an h2, so the heading outline
        stays valid and the text is real page content. That matters twice over:
        Google requires FAQPage markup to be matched by visible content on the
        page, and answer engines extract from rendered HTML rather than from a
        JSON-LD script.
      */}
      <h2 id="faq-heading" class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink">
        {title}
      </h2>
      <div class="mt-6 border-t border-line">
        {faqs.map((faq) => (
          <div class="grid gap-2 border-b border-line py-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] md:gap-10">
            <h3 class="font-display text-[1.05rem] leading-snug font-semibold tracking-[-0.01em] text-ink">
              {faq.question}
            </h3>
            <p class="text-[0.95rem] leading-relaxed text-muted">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  )
}
